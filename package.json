{
  "name": "tayloraucoin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "intake:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-engagement.ts",
    "intake:render": "node --env-file-if-exists=.env.local --import tsx scripts/render-intake.ts",
    "stripe:catalogue": "node --env-file-if-exists=.env.local --import tsx scripts/setup-stripe-catalogue.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-products.ts"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.20",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/supabase-js": "2.112.3",
    "drizzle-orm": "0.45.2",
    "motion": "^11.15.0",
    "next": "^15.1.0",
    "postgres": "3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "6.20.0",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.1.0",
    "prettier": "^3.7.0",
    "tailwindcss": "^4.0.0",
    "tsx": "4.23.12",
    "typescript": "^5.7.0"
  }
}

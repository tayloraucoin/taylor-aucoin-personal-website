# Google Analytics 4 measurement ID — stream "Taylor Aucoin Web" (15453628349).
#
# Set this ONLY on Vercel's Production environment. Leaving it unset locally and
# on preview deploys is deliberate: with no ID, no tag loads and no banner
# renders, so test traffic never reaches the property.
NEXT_PUBLIC_GA_ID=G-8BDSBZSF1X

# To test the consent banner locally, do not use an env var — set
# DEV_GEO_OVERRIDE in lib/config.ts. It is gated behind isDev().

# ─────────────────────────────────────────────────────────────────────────────
# Client intake system (docs/intake/). Server-side only — every one of these is
# read through lib/env.ts and none may reach a client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Postgres. Runtime uses the transaction pooler (6543); migrations use
# the direct session connection (5432). Two URLs, two ports, on purpose.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Storage — the private `intake` bucket. The service-role key signs
# upload and download URLs server-side. It is never sent to a browser.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Agora's account. Use a RESTRICTED key (Checkout Sessions write only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend, and the address a completed intake document is sent to.
RESEND_API_KEY=
INTAKE_NOTIFY_EMAIL=

# Guards the reminder cron route. Any long random string.
CRON_SECRET=

# Absolute origin for links in emails, Stripe return URLs, and the CLI's
# printed intake link. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tayloraucoin.com

# Stripe catalogue. `yarn stripe:catalogue --apply` creates these and prints
# the ids; run it once per mode (test and live are separate catalogues).
# Prices live in Stripe, never in code — see docs/AGORA-STRIPE.md.
STRIPE_PRICE_DEPOSIT=            # Website build, half to start — $600
STRIPE_PRICE_BALANCE=            # Website build, before go-live — $600
STRIPE_PRICE_CHANGES_STANDARD=   # Standard round of changes — $500
STRIPE_PRICE_CHANGES_SMALL=      # Small round of changes — $250
STRIPE_PRICE_EXTRA_PAGE=         # Per page beyond the standard five — $150
STRIPE_PRICE_BOOKING_SETUP=      # Online booking setup — $250
STRIPE_PRICE_GBP_CLEAN=          # Google Business Profile deep clean — $300
STRIPE_PRICE_LOGO=               # Logo refresh — $250
STRIPE_PRICE_CARE_PLAN=          # Care Plan — $250/month recurring

# Google Analytics 4 measurement ID — stream "Taylor Aucoin Web" (15453628349).
#
# Set this ONLY on Vercel's Production environment. Leaving it unset locally and
# on preview deploys is deliberate: with no ID, no tag loads and no banner
# renders, so test traffic never reaches the property.
NEXT_PUBLIC_GA_ID=G-8BDSBZSF1X

# To test the consent banner locally, do not use an env var — set
# DEV_GEO_OVERRIDE in lib/config.ts. It is gated behind isDev().

# ─────────────────────────────────────────────────────────────────────────────
# Client intake system (docs/intake/). Server-side only — every one of these is
# read through lib/env.ts and none may reach a client bundle.
#
# Credentials come in tier-specific pairs. The application never sees these
# names: next.config.ts collapses them once into canonical names
# (STRIPE_SECRET_KEY, DATABASE_URL) via lib/config/env/resolve-tier-env.ts, and
# every consumer reads only those. Same pattern as Conscious Connections
# (apps/marketing/next.config.ts + packages/auth/src/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Which tier this build runs as: `local`, `staging`, or `live`.
#
# Leave unset and it resolves itself: a Vercel production deploy is live, any
# other Vercel deploy is staging, and a machine with no VERCEL_ENV is local.
# Set it explicitly only to override that.
#
# `local` borrows the staging credentials for everything except the Stripe
# webhook secret, which `stripe listen` mints per session.
#
# Nothing unrecognised resolves to live. Staging keys in production fail loudly
# and charge nobody; live keys somewhere unintended move real money.
APP_ENVIRONMENT=

# Supabase Postgres. Runtime uses the transaction pooler (6543); migrations use
# the direct session connection (5432). Two URLs, two ports, on purpose.
DATABASE_LIVE_URL=
DIRECT_LIVE_DATABASE_URL=
DATABASE_STAGING_URL=
DIRECT_STAGING_DATABASE_URL=

# Supabase Storage — the private `intake` bucket. The service-role key signs
# upload and download URLs server-side. It is never sent to a browser.
SUPABASE_LIVE_URL=
SUPABASE_LIVE_SERVICE_ROLE_KEY=
SUPABASE_STAGING_URL=
SUPABASE_STAGING_SERVICE_ROLE_KEY=

# Stripe — Agora's account. Use a RESTRICTED key (rk_) rather than the account
# secret, scoped to Checkout + Customers + Invoices write and Tax read.
# The publishable keys are unused today: Checkout is hosted, so no Stripe code
# runs in the browser. Kept here for when something embedded needs them.
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_STAGING_PUBLISHABLE_KEY=
STRIPE_STAGING_SECRET_KEY=
STRIPE_STAGING_WEBHOOK_SECRET=

# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Used only when the tier is `local`; every other credential still comes from
# the staging pair.
STRIPE_LOCAL_WEBHOOK_SECRET=

# Stripe Prices. Also tiered: a price_… minted in test mode does not exist in
# live. `yarn stripe:catalogue --apply` prints the set for whichever mode its
# key belongs to.
STRIPE_LIVE_PRICE_DEPOSIT=            # Website build, half to start — $600
STRIPE_LIVE_PRICE_BALANCE=            # Website build, before go-live — $600
STRIPE_LIVE_PRICE_CHANGES_STANDARD=   # Standard round of changes — $500
STRIPE_LIVE_PRICE_CHANGES_SMALL=      # Small round of changes — $250
STRIPE_LIVE_PRICE_EXTRA_PAGE=         # Per page beyond the standard five — $150
STRIPE_LIVE_PRICE_BOOKING_SETUP=      # Online booking setup — $250
STRIPE_LIVE_PRICE_GBP_CLEAN=          # Google Business Profile deep clean — $300
STRIPE_LIVE_PRICE_LOGO=               # Logo refresh — $250
STRIPE_LIVE_PRICE_CARE_PLAN=          # Care Plan — $250/month recurring

STRIPE_STAGING_PRICE_DEPOSIT=
STRIPE_STAGING_PRICE_BALANCE=
STRIPE_STAGING_PRICE_CHANGES_STANDARD=
STRIPE_STAGING_PRICE_CHANGES_SMALL=
STRIPE_STAGING_PRICE_EXTRA_PAGE=
STRIPE_STAGING_PRICE_BOOKING_SETUP=
STRIPE_STAGING_PRICE_GBP_CLEAN=
STRIPE_STAGING_PRICE_LOGO=
STRIPE_STAGING_PRICE_CARE_PLAN=

# Not tiered — the same in both environments.

# Resend, and the address a completed intake document is sent to.
RESEND_API_KEY=
INTAKE_NOTIFY_EMAIL=

# Guards the reminder cron route. Any long random string.
CRON_SECRET=

# AES key for the reminder-link ciphertext: openssl rand -base64 32
INTAKE_LINK_KEY=

# Where Stripe returns clients to, and what goes in emailed links. Tiered:
# collapsing to NEXT_PUBLIC_SITE_URL happens in next.config.ts.
#
# Local resolves to http://localhost:$PORT on its own and deliberately ignores
# the live value — a test payment redirecting to the production site was a real
# bug, and production has a different database that has never heard of the
# engagement. Set _LOCAL only to override the port or test from a phone on the
# LAN. Staging uses Vercel's own deployment URL when it has one.
NEXT_PUBLIC_SITE_URL=https://tayloraucoin.com
NEXT_PUBLIC_SITE_URL_STAGING=
NEXT_PUBLIC_SITE_URL_LOCAL=

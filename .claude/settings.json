{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(npm login)",
      "Bash(npm login *)",
      "Bash(yarn npm publish)",
      "Bash(yarn npm publish *)",
      "Bash(yarn npm login)",
      "Bash(yarn npm login *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(dropdb *)",
      "Bash(*db:reset*)",
      "Bash(*db:drop*)",
      "Bash(*supabase db reset*)",
      "Bash(*drizzle-kit drop*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*DROP DATABASE*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(vercel *)",
      "Bash(yarn dlx *)",
      "Bash(*db:migrate*)",
      "Bash(*db:push*)",
      "Bash(*db:seed*)",
      "Bash(*db:setup*)",
      "Bash(*db:local:reset*)",
      "Bash(*supabase db push*)",
      "Bash(*drizzle-kit migrate*)",
      "Bash(*drizzle-kit push*)",
      "Bash(*prisma migrate deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tooling/hooks/results-gate.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tooling/hooks/session-start.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
